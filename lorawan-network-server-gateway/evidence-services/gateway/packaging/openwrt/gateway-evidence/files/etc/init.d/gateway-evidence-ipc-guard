#!/bin/sh /etc/rc.common

START=98
STOP=21
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/gateway-evidence-ipc-guard
	procd_set_param respawn 3600 5 -1
	procd_set_param file /etc/config/gateway-evidence
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger gateway-evidence
}
