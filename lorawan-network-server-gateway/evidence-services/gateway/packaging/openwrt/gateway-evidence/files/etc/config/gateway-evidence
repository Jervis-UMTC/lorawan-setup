config writer 'writer'
	option enabled '1'
	option gateway_id '0016c001f139a1cb'
	option concentratord_event_url 'ipc:///tmp/concentratord_event'
	option state_dir '/etc/gateway-evidence/journal'
	option journal_budget_bytes '104857600'
	option segment_max_records '1000'
	option segment_max_age_seconds '300'

config uploader 'uploader'
	option enabled '0'
	option gateway_id '0016c001f139a1cb'
	option state_dir '/etc/gateway-evidence/journal'
	option receipt_dir '/etc/gateway-evidence/receipts'
	option ingest_url ''
	option ca_cert_path '/etc/gateway-evidence/tls/ca.crt'
	option client_cert_path '/etc/gateway-evidence/tls/client.crt'
	option client_key_path '/etc/gateway-evidence/tls/client.key'
	option http_client_path '/usr/bin/curl'
	option retry_initial_seconds '5'
	option retry_max_seconds '300'
	option poll_seconds '5'
