# Copy to /etc/lorawan-cloud/gateway-evidence/release.env after OCI images are built.
# Every value MUST be an immutable registry reference containing @sha256:<64 hex>.
# Do not use mutable tags alone.
EVIDENCE_INGEST_IMAGE=<REGISTRY>/lorawan/gateway-evidence-ingest@sha256:<64_HEX_IMAGE_DIGEST>
EVIDENCE_COLLECTOR_IMAGE=<REGISTRY>/lorawan/gateway-mqtt-evidence-collector@sha256:<64_HEX_IMAGE_DIGEST>
EVIDENCE_VERIFIER_IMAGE=<REGISTRY>/lorawan/gateway-evidence-verifier@sha256:<64_HEX_IMAGE_DIGEST>
EVIDENCE_ADAPTER_IMAGE=<REGISTRY>/lorawan/gateway-fabric-adapter@sha256:<64_HEX_IMAGE_DIGEST>
