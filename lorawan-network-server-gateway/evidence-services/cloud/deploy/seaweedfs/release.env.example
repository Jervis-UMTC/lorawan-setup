# Immutable release inputs. Replace both placeholder digests only after inspecting
# the exact linux/amd64 manifests on the approved Docker/Buildx host.
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.41@sha256:<SEAWEEDFS_4_41_LINUX_AMD64_DIGEST>
SEAWEED_METADATA_ETCD_IMAGE=quay.io/coreos/etcd:v3.5.15@sha256:<ETCD_3_5_15_LINUX_AMD64_DIGEST>

SEAWEED_DATACENTER=sgp1
# 010 = one additional copy in another rack, same data center. Each Droplet is
# deliberately a distinct rack, so an acknowledged object has two host copies.
SEAWEED_REPLICATION=010

SEAWEED_META_CLIENT_PORT=12379
SEAWEED_META_PEER_PORT=12380
SEAWEED_MASTER_PORT=19333
SEAWEED_MASTER_GRPC_PORT=19334
SEAWEED_VOLUME_PORT=18082
SEAWEED_VOLUME_GRPC_PORT=18083
SEAWEED_FILER_PORT=18888
SEAWEED_FILER_GRPC_PORT=18889
# Seaweed's raw S3 listener is loopback-only. Evidence services use HAProxy TLS.
SEAWEED_S3_BACKEND_PORT=18333
SEAWEED_S3_GRPC_PORT=18334
SEAWEED_S3_TLS_FRONTEND_PORT=18443

SEAWEED_MASTER_PEERS=10.104.0.2:19333,10.104.0.4:19333,10.104.0.8:19333
SEAWEED_META_INITIAL_CLUSTER=swmeta-01=http://10.104.0.2:12380,swmeta-02=http://10.104.0.4:12380,swmeta-03=http://10.104.0.8:12380
SEAWEED_META_CLUSTER_TOKEN=lorawan-seaweed-metadata-v1
SEAWEED_VOLUME_SIZE_LIMIT_MB=1024
SEAWEED_VOLUME_MAX=12
