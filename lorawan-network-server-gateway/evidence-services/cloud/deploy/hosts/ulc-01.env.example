# Non-secret host/release wiring for ulc-01 (10.104.0.2).
EVIDENCE_HOST_ID=ulc-01
COMPOSE_PROFILES=ingest,collector,fabric-adapter
EVIDENCE_PRIVATE_BIND_IP=10.104.0.2
EVIDENCE_PGBOUNCER_HOST_IP=10.104.0.2

# Select currently free host ports during preflight; these are intentionally not
# guessed in the repository because the live server already carries many roles.
EVIDENCE_INGEST_HOST_PORT=<FREE_PRIVATE_INGEST_BACKEND_PORT>
EVIDENCE_COLLECTOR_HEALTH_PORT=<FREE_LOOPBACK_HEALTH_PORT>
EVIDENCE_ADAPTER_HEALTH_PORT=<FREE_LOOPBACK_HEALTH_PORT>

EVIDENCE_COMMON_ENV_FILE=/etc/lorawan-cloud/gateway-evidence/common.env
EVIDENCE_INGEST_ENV_FILE=/etc/lorawan-cloud/gateway-evidence/ingest.env
EVIDENCE_COLLECTOR_ENV_FILE=/etc/lorawan-cloud/gateway-evidence/collector.env

# Used only with compose.fabric-adapter-enabled.yml after the external handoff.
FABRIC_ADAPTER_WORKER_ID=fabric-adapter-ulc-01
FABRIC_ADAPTER_ENV_FILE=/etc/lorawan-cloud/gateway-evidence/fabric-adapter.env
OPENBAO_CA_HOST_PATH=/etc/lorawan-pki/openbao/ca.crt
OPENBAO_APPROLE_ROLE_ID_HOST_PATH=/etc/lorawan-cloud/fabric-adapter/role_id
OPENBAO_APPROLE_SECRET_ID_HOST_PATH=/etc/lorawan-cloud/fabric-adapter/secret_id
FABRIC_TLS_ROOT_CERT_HOST_PATH=/etc/lorawan-pki/fabric/tls-ca.crt
FABRIC_CERT_HOST_PATH=/etc/lorawan-pki/fabric/client.crt
FABRIC_KEY_HOST_PATH=/etc/lorawan-pki/fabric/client.key

EVIDENCE_POSTGRES_CA_HOST_PATH=/etc/lorawan-pki/gateway-evidence/postgres-ca.crt
EVIDENCE_S3_CA_HOST_PATH=/etc/lorawan-pki/gateway-evidence/s3-ca.crt
EVIDENCE_INGEST_TLS_CERT_HOST_PATH=/etc/lorawan-pki/gateway-evidence/ingest-server.crt
EVIDENCE_INGEST_TLS_KEY_HOST_PATH=/etc/lorawan-pki/gateway-evidence/ingest-server.key
EVIDENCE_INGEST_CLIENT_CA_HOST_PATH=/etc/lorawan-pki/gateway-evidence/gateway-client-ca.crt
EVIDENCE_MQTT_CA_HOST_PATH=/etc/lorawan-pki/gateway-evidence/mqtt-ca.crt

EVIDENCE_COLLECTOR_AUTH_MODE=mtls
EVIDENCE_MQTT_BROKER1_CLIENT_ID=evidence-collector-ulc-01-broker1
EVIDENCE_MQTT_BROKER2_CLIENT_ID=evidence-collector-ulc-01-broker2

# Required only when EVIDENCE_COLLECTOR_AUTH_MODE=mtls.
EVIDENCE_MQTT_BROKER1_CERT_HOST_PATH=/etc/lorawan-pki/gateway-evidence/collector-broker1.crt
EVIDENCE_MQTT_BROKER1_KEY_HOST_PATH=/etc/lorawan-pki/gateway-evidence/collector-broker1.key
EVIDENCE_MQTT_BROKER2_CERT_HOST_PATH=/etc/lorawan-pki/gateway-evidence/collector-broker2.crt
EVIDENCE_MQTT_BROKER2_KEY_HOST_PATH=/etc/lorawan-pki/gateway-evidence/collector-broker2.key
