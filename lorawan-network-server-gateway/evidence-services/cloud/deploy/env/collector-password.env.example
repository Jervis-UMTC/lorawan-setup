# PROTECTED FILE: install as root:root mode 0600.
# The login role must be a member of NOLOGIN role gateway_evidence_collector.
EVIDENCE_DATABASE_DSN=postgresql://<COLLECTOR_LOGIN>:<URL_ENCODED_PASSWORD>@pgbouncer.internal.lorawan.com:6432/lorawan_telemetry?sslmode=verify-full&sslrootcert=/run/evidence/postgres/ca.crt

# Collector writes immutable MQTT witness objects and therefore needs HeadBucket,
# GetObject, and conditional PutObject on the configured evidence prefix.
EVIDENCE_S3_ACCESS_KEY_ID=<COLLECTOR_S3_ACCESS_KEY_ID>
EVIDENCE_S3_SECRET_ACCESS_KEY=<COLLECTOR_S3_SECRET_ACCESS_KEY>

EVIDENCE_MQTT_REGION=as923
EVIDENCE_MQTT_TOPIC_FILTER=as923/gateway/+/event/#
EVIDENCE_MQTT_CA_FILE=/run/evidence/mqtt/ca.crt
EVIDENCE_MQTT_TLS_SERVER_NAME=mqtt.internal.lorawan.com
EVIDENCE_MQTT_SESSION_EXPIRY_SECONDS=604800
EVIDENCE_MQTT_KEEPALIVE_SECONDS=30

# Dedicated read-only broker identities. ACL must allow only SUBSCRIBE/READ on
# as923/gateway/+/event/# and must deny publish.
EVIDENCE_MQTT_BROKER1_USERNAME=<BROKER1_READONLY_USERNAME>
EVIDENCE_MQTT_BROKER1_PASSWORD=<BROKER1_READONLY_PASSWORD>
EVIDENCE_MQTT_BROKER2_USERNAME=<BROKER2_READONLY_USERNAME>
EVIDENCE_MQTT_BROKER2_PASSWORD=<BROKER2_READONLY_PASSWORD>
