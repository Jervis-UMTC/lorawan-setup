# Copy to /etc/lorawan-cloud/gateway-evidence/fabric-adapter.env only after the
# external Fabric handoff is complete. Actual file: root:root mode 0600.
# This file contains the database password and Fabric topology identifiers.
# OpenBao RoleID/SecretID and Fabric certificate/private key remain mounted as
# files and are not copied into this env file.

FABRIC_ADAPTER_DATABASE_URL=postgres://fabric_adapter:<FABRIC_ADAPTER_DATABASE_PASSWORD>@pgbouncer.internal.lorawan.com:6432/lorawan_telemetry?sslmode=verify-full&sslrootcert=/run/evidence/postgres/ca.crt
FABRIC_ADAPTER_DATABASE_EXPECTED_HOST=pgbouncer.internal.lorawan.com
FABRIC_ADAPTER_DATABASE_EXPECTED_NAME=lorawan_telemetry
FABRIC_ADAPTER_DB_MAX_CONNS=2
FABRIC_ADAPTER_PROCESSING_LEASE_SECONDS=90
FABRIC_ADAPTER_POLL_SECONDS=2
FABRIC_MAX_ATTEMPTS=10
FABRIC_RETRY_BASE_DELAY_SECONDS=5
FABRIC_RETRY_MAX_DELAY_SECONDS=300
FABRIC_RETRY_JITTER_SECONDS=2
FABRIC_COMMIT_TIMEOUT_SECONDS=30

OPENBAO_ADDR=https://openbao-kms.internal.lorawan.com:18200
OPENBAO_CA_FILE=/run/openbao/ca.crt
OPENBAO_TRANSIT_MOUNT=transit
OPENBAO_TRANSIT_KEY=lorawan-evidence
OPENBAO_APPROLE_ROLE_ID_FILE=/run/openbao-approle/role_id
OPENBAO_APPROLE_SECRET_ID_FILE=/run/openbao-approle/secret_id

# The HRC team's live 10.43.25.198:7051 address is a K3s ClusterIP and is NOT
# a valid ULC-01/ULC-02 endpoint. Replace this only with the restricted
# ULC-reachable Gateway address provisioned by the Fabric team.
FABRIC_GATEWAY_ENDPOINT=<HRC_ULC_REACHABLE_GATEWAY_HOST>:7051
FABRIC_TLS_SERVER_NAME=peer1.hrc.local
FABRIC_TLS_ROOT_CERT=/run/fabric/tls/ca.crt
FABRIC_MSP_ID=HrcMSP
FABRIC_CERT_PATH=/run/fabric/identity/client.crt
FABRIC_KEY_PATH=/run/fabric/identity/client.key
FABRIC_CHANNEL=hrc-channel
FABRIC_CHAINCODE=hrc-evidence
# HRC uses the chaincode default contract. Do not substitute the Caliper alias
# "hrcEvidence" here.
FABRIC_CONTRACT=
# Freeze one stable LoRaWAN trust-boundary identity with both teams before
# activation. It must match [A-Za-z0-9._:-]{1,128}.
FABRIC_AUTHENTICATED_SOURCE_SYSTEM_ID=lorawan-gateway-evidence
FABRIC_SUBMIT_FUNCTION=CreateSourceBoundAnchor
FABRIC_QUERY_FUNCTION=QuerySourceBoundAnchor
FABRIC_VERIFY_FUNCTION=VerifySourceBoundDigest
