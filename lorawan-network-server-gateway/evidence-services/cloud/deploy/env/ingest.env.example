# PROTECTED FILE: install as root:root mode 0600.
# The login role must be a member of NOLOGIN role gateway_evidence_ingestor.
# URL-encode the login/password before placing them in this URI.
EVIDENCE_DATABASE_DSN=postgresql://<INGEST_LOGIN>:<URL_ENCODED_PASSWORD>@pgbouncer.internal.lorawan.com:6432/lorawan_telemetry?sslmode=verify-full&sslrootcert=/run/evidence/postgres/ca.crt

# Use a dedicated S3 credential with HeadBucket + GetObject + conditional PutObject
# only for the configured evidence bucket/prefix.
EVIDENCE_S3_ACCESS_KEY_ID=<INGEST_S3_ACCESS_KEY_ID>
EVIDENCE_S3_SECRET_ACCESS_KEY=<INGEST_S3_SECRET_ACCESS_KEY>

EVIDENCE_TLS_CERT_FILE=/run/evidence/ingest/tls.crt
EVIDENCE_TLS_KEY_FILE=/run/evidence/ingest/tls.key
EVIDENCE_TLS_CLIENT_CA_FILE=/run/evidence/ingest/client-ca.crt
