# PROTECTED FILE: install as root:root mode 0600.
# The login role must be a member of NOLOGIN role gateway_evidence_verifier.
EVIDENCE_DATABASE_DSN=postgresql://<VERIFIER_LOGIN>:<URL_ENCODED_PASSWORD>@pgbouncer.internal.lorawan.com:6432/lorawan_telemetry?sslmode=verify-full&sslrootcert=/run/evidence/postgres/ca.crt

# Verifier only needs HeadBucket + GetObject for the evidence bucket/prefix.
EVIDENCE_S3_ACCESS_KEY_ID=<VERIFIER_S3_ACCESS_KEY_ID>
EVIDENCE_S3_SECRET_ACCESS_KEY=<VERIFIER_S3_SECRET_ACCESS_KEY>

EVIDENCE_VERIFIER_LEASE_SECONDS=60
EVIDENCE_VERIFIER_RETRY_SECONDS=30
EVIDENCE_VERIFIER_POLL_SECONDS=2
EVIDENCE_VERIFIER_DISCOVERY_LIMIT=100
