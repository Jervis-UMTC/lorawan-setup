    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lorawan-telemetry"
      },
      "fieldConfig": {
        "defaults": {
          "description": "All 13 decoded measurements from the newest EMU-01 observation, with presentation units."
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 7,
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lorawan-telemetry"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (\n  SELECT max(time) AS t FROM telemetry.measurements WHERE dev_eui='ac1f09fffe296d29'\n)\nSELECT\n  m.time AS \"Observed\",\n  round(max(m.metric_value) FILTER (WHERE m.metric_name='environment_temperature_c')::numeric,1) AS \"Air °C\",\n  round(max(m.metric_value) FILTER (WHERE m.metric_name='environment_humidity_percent')::numeric,1) AS \"Air humidity %\",\n  round((max(m.metric_value) FILTER (WHERE m.metric_name='environment_pressure_pa')/1000.0)::numeric,2) AS \"Air pressure kPa\",\n  round((max(m.metric_value) FILTER (WHERE m.metric_name='environment_gas_resistance_ohm')/1000.0)::numeric,2) AS \"Gas kΩ\",\n  round(max(m.metric_value) FILTER (WHERE m.metric_name='barometer_temperature_c')::numeric,1) AS \"Barometer °C\",\n  round((max(m.metric_value) FILTER (WHERE m.metric_name='barometer_pressure_pa')/1000.0)::numeric,2) AS \"Barometer kPa\",\n  round(max(m.metric_value) FILTER (WHERE m.metric_name='soil_moisture_percent')::numeric,1) AS \"Soil moisture %\",\n  round(max(m.metric_value) FILTER (WHERE m.metric_name='soil_temperature_c')::numeric,1) AS \"Soil °C\",\n  round(max(m.metric_value) FILTER (WHERE m.metric_name='light_opt3001_lux')::numeric,1) AS \"OPT3001 lux\",\n  round(max(m.metric_value) FILTER (WHERE m.metric_name='light_veml7700_lux')::numeric,1) AS \"VEML7700 lux\",\n  round(max(m.metric_value) FILTER (WHERE m.metric_name='uv_index')::numeric,1) AS \"UV index\",\n  CASE WHEN bool_or(m.metric_bool) FILTER (WHERE m.metric_name='rain_wet') THEN 'Wet' ELSE 'Dry' END AS \"Rain\",\n  round(max(m.metric_value) FILTER (WHERE m.metric_name='battery_v')::numeric,2) AS \"Battery V\"\nFROM telemetry.measurements m, latest l\nWHERE m.dev_eui='ac1f09fffe296d29' AND m.time=l.t\nGROUP BY m.time;",
          "refId": "A"
        }
      ],
      "title": "EMU-01 · latest agriculture readings",
      "type": "table",
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
