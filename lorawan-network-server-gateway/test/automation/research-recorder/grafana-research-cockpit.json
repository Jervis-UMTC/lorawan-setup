          "rawSql": "SELECT time AS \"Arrived\",\n CASE dev_eui WHEN 'ac1f09fffe296d29' THEN 'EMU-01 · Agriculture' WHEN 'ac1f09fffe296aeb' THEN 'SEC-02 · Security' ELSE dev_eui END AS \"Sender\",\n payload_json->>'test_sequence' AS \"Sequence\", f_cnt AS \"FCnt\",\n round(rssi_dbm::numeric,1) AS \"RSSI dBm\", round(snr_db::numeric,1) AS \"SNR dB\",\n round((gateway_frequency_hz/1000000.0)::numeric,3) AS \"Frequency MHz\"\nFROM telemetry.uplinks WHERE dev_eui IN ('ac1f09fffe296d29','ac1f09fffe296aeb') ORDER BY time DESC LIMIT 30;",
