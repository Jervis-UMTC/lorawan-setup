{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zacharias:lorawan-fabric:run-manifest:1.0",
  "type": "object",
  "required": [
    "schema_version",
    "study_id",
    "test_id",
    "run_id",
    "repetition",
    "created_at_utc",
    "requested_fabric_action",
    "authenticated_source_system_id",
    "formal",
    "workload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "study_id": {
      "const": "zacharias-lorawan-fabric"
    },
    "test_id": {
      "enum": [
        "P1",
        "P2",
        "R1",
        "R2",
        "A1",
        "A2",
        "I1",
        "I2",
        "I3",
        "T1",
        "T2"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "repetition": {
      "type": "integer",
      "minimum": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "requested_fabric_action": {
      "type": "string",
      "minLength": 1
    },
    "authenticated_source_system_id": {
      "const": "lorawan-gateway-evidence"
    },
    "formal": {
      "type": "boolean"
    },
    "fabric_required": {
      "type": "boolean"
    },
    "workload": {
      "type": "object",
      "properties": {
        "target_tps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "interval_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "planned_record_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "schedule_epoch_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "pair_order": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "enum": [
              "control",
              "fabric"
            ]
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
